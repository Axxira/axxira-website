{
  "name": "dungeonmappilot-subscriptions",
  "main": "src/cloudflare.mjs",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": true, "not_found_handling": "single-page-application" },
  "durable_objects": { "bindings": [{ "name": "BILLING", "class_name": "BillingStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BillingStore"] }],
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],
  "vars": { "PAYPAL_ENV": "live", "BILLING_ENABLED": "false", "LIVE_VERIFIED": "false", "PUBLIC_ORIGIN": "https://dungeonmappilot-subscriptions.tyronixstudio.workers.dev" },
  "triggers": { "crons": ["17 * * * *"] },
  "observability": { "enabled": false }
}
