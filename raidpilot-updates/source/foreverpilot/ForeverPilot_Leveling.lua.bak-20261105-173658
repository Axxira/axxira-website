local function D() return _G.Ding end
local function ids(v)
    if type(v) == "number" then return { v } end
    if type(v) == "table" then return v end
    return {}
end

local function qname(id)
    local d = D()
    if d and d.Data and type(d.Data.QuestName) == "function" then
        local ok, name = pcall(function() return d.Data:QuestName(id) end)
        if ok and name and name ~= "" then return name end
    end
    return "Quest " .. tostring(id)
end

local function names(v, limit)
    local out = {}
    for _, id in ipairs(ids(v)) do
        out[#out + 1] = qname(id)
        if limit and #out >= limit then break end
    end
    return table.concat(out, ", ")
end

local function formatTime(seconds)
    if not seconds or seconds <= 0 or seconds > 60 * 60 * 72 then return "--" end
    seconds = math.floor(seconds + 0.5)
    if seconds < 60 then return seconds .. "s" end
    local m = math.floor(seconds / 60)
    if m < 60 then return m .. "m" end
    local h = math.floor(m / 60)
    m = m % 60
    if h < 24 then return h .. "h " .. m .. "m" end
    return math.floor(h / 24) .. "j " .. (h % 24) .. "h"
end

local function comma(n)
    n = math.floor(tonumber(n) or 0)
    local s = tostring(n)
    while true do
        local next, k = s:gsub("^(-?%d+)(%d%d%d)", "%1,%2")
        s = next
        if k == 0 then break end
    end
    return s
end

local function applies(step)
    local d = D()
    if not d or not step then return false end
    if type(d.StepApplies) == "function" then
        local ok, yes = pcall(function() return d:StepApplies(step) end)
        if ok then return yes and true or false end
    end
    return true
end

local function callEngine(method)
    local d = D()
    if not d or not d.Engine or type(d.Engine[method]) ~= "function" then return false end
    return pcall(function() d.Engine[method](d.Engine) end)
end

local function configureFast()
    local d = D()
    if not d then return end
    d.TITLE = "ForeverPilot Leveling"
    if d.db and d.db.ui then
        d.db.ui.autoAccept = true
        d.db.ui.autoTurnin = true
        d.db.ui.hearth = true
        d.db.ui.offers = true
        d.db.ui.flightSteps = true
        d.db.ui.trainerSteps = true
        d.db.ui.serviceSteps = true
        d.db.ui.skipGrey = ForeverPilotLevelingDB.fastMode ~= false
        d.db.ui.dungeons = ForeverPilotLevelingDB.dungeons == true
        d.db.ui.elites = ForeverPilotLevelingDB.elites == true
    end
    if d.db and d.db.panel then
        d.db.panel.why = true
        d.db.panel.shown = true
    end
    if d.db and d.db.arrow then d.db.arrow.shown = true end
end

local function stepKind(step)
    if #ids(step.turnin) > 0 then return "TURNIN" end
    if #ids(step.accept) > 0 then return "ACCEPT" end
    if #ids(step.complete) > 0 or step.collect then return "DO" end
    if step.hearth then return "HEARTH" end
    if step.fly then return "FLY" end
    if step.train then return "TRAIN" end
    if step.go then return "GO" end
    if step.vendor or step.repair then return "SERVICE" end
    return "STEP"
end

local KIND = {
    ACCEPT = "|cff63e6bePRENDS|r",
    TURNIN = "|cff69f08aRENDS|r",
    DO = "|cffffcc66FAIS|r",
    GO = "|cff6fc8ffVA|r",
    FLY = "|cff8bb8ffVOL|r",
    HEARTH = "|cffff9b66HEARTH|r",
    TRAIN = "|cffd59cffTRAIN|r",
    SERVICE = "|cffb7c0ccSERVICE|r",
    STEP = "|cffb7c0ccÉTAPE|r",
}

local function stepText(step)
    if not step then return "Route en attente" end
    local parts = {}
    if #ids(step.turnin) > 0 then parts[#parts + 1] = "Rends " .. names(step.turnin, 2) end
    if #ids(step.accept) > 0 then parts[#parts + 1] = "Prends " .. names(step.accept, 2) end
    if #ids(step.complete) > 0 then parts[#parts + 1] = "Termine " .. names(step.complete, 2) end
    if #parts == 0 and step.text and step.text ~= "" then parts[#parts + 1] = step.text end
    if #parts == 0 and step.hearth then parts[#parts + 1] = "Utilise ta pierre de foyer" end
    if #parts == 0 and step.fly then parts[#parts + 1] = "Prends le maître de vol" end
    if #parts == 0 and step.train then parts[#parts + 1] = "Entraîne tes compétences" end
    if #parts == 0 and step.go then parts[#parts + 1] = "Suis la flèche vers le prochain point" end
    if #parts == 0 then parts[#parts + 1] = "Suis cette étape" end
    return table.concat(parts, " • ")
end

local function stepReason(step)
    local d = D()
    if d and d.Why and type(d.Why.Short) == "function" then
        local ok, why = pcall(function() return d.Why:Short(step) end)
        if ok and why and why ~= "" then return why end
    end
    local why = step and step.why
    if type(why) == "table" and why.seconds and why.xp then
        return ("Détour ~%s pour ~%s XP"):format(formatTime(why.seconds), comma(why.xp))
    end
    return nil
end

local function nextSteps(maxRows)
    local d = D()
    if not d or not d.Engine or not d.Engine.guide then return {} end
    local e, g = d.Engine, d.Engine.guide
    local out = {}
    for i = e.index or 1, #g.steps do
        local s = g.steps[i]
        if applies(s) then
            out[#out + 1] = { step = s, index = i }
            if #out >= maxRows then break end
        end
    end
    return out
end

local function loopAdvice()
    local d = D()
    if not d or not d.Engine or not d.Engine.guide then
        return "SYNC", "Synchronisation de la route…", 0.55, 0.80, 1.00
    end
    local e, g = d.Engine, d.Engine.guide
    local idx = e.index or 1
    local current = g.steps[idx]
    if current and applies(current) and #ids(current.turnin) > 0 then
        return "HUB", "RETOUR / HUB — rends les quêtes indiquées, puis prends toutes les suivantes avant de repartir.", 0.35, 1.00, 0.55
    end
    if current and applies(current) and #ids(current.accept) > 0 then
        return "PICKUP", "AVANT DE PARTIR — prends toutes les quêtes de cette étape. Ne quitte pas le hub trop tôt.", 0.35, 0.90, 1.00
    end
    if current and applies(current) and current.hearth then
        return "HEARTH", "HEARTH MAINTENANT — la route a calculé que le retour est rentable.", 1.00, 0.70, 0.30
    end
    if current and applies(current) and current.fly then
        return "FLIGHT", "TRANSIT — prends ce vol; il évite une portion de déplacement non rentable.", 0.45, 0.72, 1.00
    end

    local actions, objectives, accepts = 0, 0, 0
    for i = idx, math.min(#g.steps, idx + 20) do
        local s = g.steps[i]
        if applies(s) then
            if #ids(s.turnin) > 0 and i > idx then
                if objectives > 0 then
                    return "HOLD", ("NE RENTRE PAS ENCORE — %d objectif(s) / %d étape(s) sont planifiés avant le prochain turn-in."):format(objectives, actions), 1.00, 0.72, 0.20
                end
                return "RETURN", ("Prochain retour dans environ %d étape(s). Continue la route."):format(actions), 0.65, 0.88, 1.00
            end
            if #ids(s.complete) > 0 or s.collect then objectives = objectives + 1 end
            if #ids(s.accept) > 0 then accepts = accepts + 1 end
            actions = actions + 1
        end
    end
    if accepts > 0 then
        return "ROUTE", "Continue la boucle — des quêtes supplémentaires seront prises en chemin.", 0.55, 0.86, 1.00
    end
    return "ROUTE", "Continue la route optimisée. La flèche t'amène au prochain objectif rentable.", 0.55, 0.86, 1.00
end

local sessionStart, startLevelEquiv
local lastLevel, lastXP, lastMax
local sessionXP = 0

local function sampleXP()
    local level = UnitLevel("player") or 1
    local xp = UnitXP("player") or 0
    local max = UnitXPMax("player") or 1
    if not sessionStart then
        sessionStart = GetTime()
        startLevelEquiv = level + (max > 0 and xp / max or 0)
        lastLevel, lastXP, lastMax = level, xp, max
        return
    end
    local delta = 0
    if lastLevel then
        if level == lastLevel then
            delta = xp - (lastXP or 0)
        elseif level > lastLevel then
            delta = math.max(0, (lastMax or 0) - (lastXP or 0)) + xp
        end
    end
    if delta > 0 and delta < 10000000 then sessionXP = sessionXP + delta end
    lastLevel, lastXP, lastMax = level, xp, max
end

local function pace()
    sampleXP()
    local elapsed = math.max(1, GetTime() - (sessionStart or GetTime()))
    local xpH = sessionXP * 3600 / elapsed
    local level = UnitLevel("player") or 1
    local xp = UnitXP("player") or 0
    local max = UnitXPMax("player") or 1
    local nextETA = xpH > 1 and (max - xp) / xpH * 3600 or nil

    local equiv = level + (max > 0 and xp / max or 0)
    local progress = startLevelEquiv and (equiv - startLevelEquiv) or 0
    local eta60
    if elapsed >= 120 and progress >= 0.03 then
        local levelsPerSec = progress / elapsed
        eta60 = levelsPerSec > 0 and math.max(0, 60 - equiv) / levelsPerSec or nil
    end
    return xpH, nextETA, eta60
end

