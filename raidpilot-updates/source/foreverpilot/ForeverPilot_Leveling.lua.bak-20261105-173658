SLASH_FOREVERPILOTLEVELING1 = "/fpl"
SlashCmdList.FOREVERPILOTLEVELING = function(msg)
    msg = (msg or ""):lower():match("^%s*(.-)%s*$")
    local d = D()
    if msg == "" then
        if frame:IsShown() then frame:Hide(); db.shown = false else frame:Show(); db.shown = true end
    elseif msg == "guide" and d and d.Panel then
        d.Panel:Toggle()
    elseif msg == "next" then
        callEngine("Next")
    elseif msg == "prev" then
        callEngine("Prev")
    elseif msg == "skip" then
        callEngine("Skip")
    elseif msg == "reset" or msg == "resync" then
        callEngine("Reset")
    elseif msg == "arrow" and d and d.Arrow then
        d.Arrow:Toggle()
    elseif msg == "fast" then
        db.fastMode = not db.fastMode
        configureFast()
        update()
    elseif msg == "config" and d and d.Config then
        d.Config:Open()
    elseif msg == "stats" then
        local xpH, nextETA, eta60 = pace()
        DEFAULT_CHAT_FRAME:AddMessage(("|cff48D7E8ForeverPilot|r %s XP/h • prochain niveau %s • projection 60 %s"):format(comma(xpH), formatTime(nextETA), formatTime(eta60)))
    elseif msg == "debug" then
        local e = d and d.Engine
        DEFAULT_CHAT_FRAME:AddMessage(("|cff48D7E8ForeverPilot|r Ding=%s guide=%s index=%s"):format(tostring(d ~= nil), tostring(e and e.guide and e.guide.id), tostring(e and e.index)))
    else
        DEFAULT_CHAT_FRAME:AddMessage("|cff48D7E8ForeverPilot SMART|r /fpl | guide | resync | arrow | fast | stats | next | prev | skip | config | debug")
    end
end
