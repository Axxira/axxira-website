local function update()
    local d = D()
    local level = UnitLevel("player") or 0
    local xp = UnitXP("player") or 0
    local max = UnitXPMax("player") or 1
    local pct = max > 0 and math.floor(xp / max * 100 + 0.5) or 0
    local faction = UnitFactionGroup("player") or "?"
    local zone = GetZoneText and GetZoneText() or ""
    status:SetText(("Niveau %d  •  %d%%  •  %s  •  %s"):format(level, pct, faction, zone ~= "" and zone or "zone inconnue"))

    local xpH, nextETA, eta60 = pace()
    kpi1:SetText("|cff69f08a" .. comma(xpH) .. "|r XP/h")
    kpi2:SetText("Niv.+1  |cffffffff" .. formatTime(nextETA) .. "|r")
    kpi3:SetText("Proj. 60  |cffffffff" .. formatTime(eta60) .. "|r")

    if d and d.Engine and d.Engine.guide then
        local e, g = d.Engine, d.Engine.guide
        local n, total = 0, 0
        if type(e.StepNumber) == "function" then
            local ok, a, b = pcall(function() return e:StepNumber(e.index, g) end)
            if ok then n, total = a or 0, b or 0 end
        end
        local nextGuide = type(e.NextGuide) == "function" and e:NextGuide(g) or nil
        route:SetText(("Route: |cffffffff%s|r   •   Étape %d/%d%s"):format(
            g.title or g.id or "route",
            n, total,
            nextGuide and ("   •   Ensuite: " .. (nextGuide.title or nextGuide.id)) or ""
        ))
    else
        route:SetText("Route: synchronisation avec le moteur…")
    end

    local _, advice, r, g, b = loopAdvice()
    callout:SetText(advice)
    callout:SetTextColor(r, g, b)
    calloutBox:SetBackdropBorderColor(r * 0.75, g * 0.75, b * 0.75, 1)

    local list = nextSteps(4)
    for i = 1, 4 do
        local row = rows[i]
        local item = list[i]
        if item then
            local kind = stepKind(item.step)
            local reason = stepReason(item.step)
            local text = (KIND[kind] or KIND.STEP) .. "  " .. stepText(item.step)
            if reason then text = text .. "  |cff8f9dad• " .. reason .. "|r" end
            row.num:SetText("|cff48D7E8" .. i .. "|r")
            row.text:SetText(text)
            row.frame:Show()
        else
            row.frame:Hide()
        end
    end

    local unused = 0
    if d and d.Engine and type(d.Engine.UnusedLogQuests) == "function" then
        local ok, q = pcall(function() return d.Engine:UnusedLogQuests() end)
        if ok and type(q) == "table" then unused = #q end
    end
    local journal = unused > 0 and ("|cffffb45c" .. unused .. " quête(s) hors route dans le journal|r") or "|cff69f08aJournal aligné à la route|r"
    intel:SetText(journal .. "   •   FAST: " .. (db and db.fastMode ~= false and "|cff69f08aON|r" or "|cffffb45cOFF|r") .. "   •   /fpl config pour les options")
    if fastBtn then fastBtn:SetText(db and db.fastMode ~= false and "FAST ON" or "FAST OFF") end
end

