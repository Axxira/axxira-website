local function button(text,x,fn)
    local b=CreateFrame("Button",nil,frame,"UIPanelButtonTemplate")
    b:SetSize(58,23)
    b:SetPoint("BOTTOMLEFT",x,15)
    b:SetText(text)
    b:SetScript("OnClick",fn)
    return b
end

button("Guide",14,function()
    local D=ding()
    if D and D.Panel and D.Panel.Toggle then D.Panel:Toggle() end
end)
button("Prev",76,function() callEngine("Prev") end)
button("Next",138,function() callEngine("Next") end)
button("Skip",200,function() callEngine("Skip") end)
button("Reset",262,function() callEngine("Reset") end)

local function update()
    local D=ding()
    local lvl=UnitLevel("player") or 0
    local xp=UnitXP("player") or 0
    local max=UnitXPMax("player") or 0
    local pct=max>0 and math.floor((xp/max)*100+0.5) or 0
    local faction=UnitFactionGroup("player") or "?"
    status:SetText(("Niveau %d (%d%%) • %s"):format(lvl,pct,faction))
    if D and D.char then
        route:SetText(("Route: %s   •   Étape %s"):format(tostring(D.char.guide or "auto"), tostring(D.char.step or 1)))
    else
        route:SetText("Moteur de route: chargement...")
    end
end

local events=CreateFrame("Frame")
events:RegisterEvent("PLAYER_LOGIN")
events:RegisterEvent("PLAYER_LEVEL_UP")
events:RegisterEvent("QUEST_LOG_UPDATE")
events:SetScript("OnEvent",function(_,event)
    if event=="PLAYER_LOGIN" then
        ForeverPilotLevelingDB = type(ForeverPilotLevelingDB)=="table" and ForeverPilotLevelingDB or {}
        C_Timer.After(1.0,function()
            configure()
            update()
            DEFAULT_CHAT_FRAME:AddMessage("|cff48D7E8ForeverPilot Leveling|r v"..VERSION.." prêt. /fpl")
        end)
    else
        update()
    end
end)

local elapsed=0
frame:SetScript("OnUpdate",function(_,dt)
    elapsed=elapsed+dt
    if elapsed>=1 then elapsed=0; update() end
end)

SLASH_FOREVERPILOTLEVELING1="/fpl"
SlashCmdList.FOREVERPILOTLEVELING=function(msg)
    msg=(msg or ""):lower():match("^%s*(.-)%s*$")
    local D=ding()
    if msg=="" then
        if frame:IsShown() then frame:Hide() else frame:Show() end
    elseif msg=="guide" and D and D.Panel then
        D.Panel:Toggle()
    elseif msg=="next" then
        callEngine("Next")
    elseif msg=="prev" then
        callEngine("Prev")
    elseif msg=="skip" then
        callEngine("Skip")
    elseif msg=="reset" then
        callEngine("Reset")
    elseif msg=="config" and D and D.Config then
        D.Config:Open()
    else
        DEFAULT_CHAT_FRAME:AddMessage("|cff48D7E8ForeverPilot Leveling|r /fpl guide | next | prev | skip | reset | config")
    end
end
