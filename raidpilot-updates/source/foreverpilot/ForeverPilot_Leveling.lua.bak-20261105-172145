-- ForeverPilot Leveling 0.3.0
-- Companion/control layer for Ding! (GPLv3). Ding supplies the open Forever 1-60 route data.
local VERSION = "0.3.0"
local FPL = {}
_G.ForeverPilotLeveling = FPL

local function ding()
    return _G.Ding
end

local function callEngine(method)
    local D = ding()
    if not D or not D.Engine or type(D.Engine[method]) ~= "function" then return false end
    return pcall(function() D.Engine[method](D.Engine) end)
end

local function configure()
    local D = ding()
    if not D then return end
    D.TITLE = "ForeverPilot Leveling"
    if D.db and D.db.ui then
        D.db.ui.autoAccept = true
        D.db.ui.autoTurnin = true
        D.db.ui.hearth = true
        D.db.ui.offers = true
        D.db.ui.flightSteps = true
        D.db.ui.skipGrey = false
    end
    if D.db and D.db.panel then
        D.db.panel.shown = true
        D.db.panel.why = true
    end
    if D.db and D.db.arrow then
        D.db.arrow.shown = true
    end
    if D.char and not D.char.guide and D.Engine and D.Engine.Reset then
        pcall(function() D.Engine:Reset() end)
    end
end

